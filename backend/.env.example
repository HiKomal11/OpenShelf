# PostgreSQL database connection
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/pdf_library

# Authentication — replace with a strong, random secret
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET

# Optional session secret; configure separately in production
SESSION_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Google OAuth (optional; required for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Gmail SMTP (required for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=YOUR_GMAIL_ADDRESS

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Optional application settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
MAX_PDF_SIZE_MB=50

# PDF storage — use Vercel Blob in production
STORAGE_BACKEND=vercel_blob
STORAGE_DIR=storage
BLOB_READ_WRITE_TOKEN=